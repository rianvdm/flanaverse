{
  "name": "flanaverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive map of Mike Flanagan's films and series, the actors who keep returning, and the props and easter eggs that tie them together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-tmdb.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "minisearch": "^7.2.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  }
}
